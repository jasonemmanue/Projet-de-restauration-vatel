# Variables d'environnement de CANTINE VATEL.
# Ce fichier ne contient aucune valeur reelle : il ne donne que les noms et leur role.
# Copier en .env en local, et poser les memes noms dans les variables Railway.
# Le depot est public : aucune valeur ne doit etre commitee.

# --- Application ---------------------------------------------------------
APP_NOM=                      # Nom affiche dans les e-mails et les reponses techniques
APP_ENV=                      # local, demo ou production
APP_COMMIT=                   # Commit deploye, renvoye par GET /sante, pose par Railway
API_URL_PUBLIQUE=             # URL publique de l'API, utilisee dans les liens de paiement
SITE_URL_PUBLIQUE=            # URL publique du site Next.js
LOG_NIVEAU=                   # debug, info ou warning

# --- Base de donnees -----------------------------------------------------
DATABASE_URL=                 # postgresql+asyncpg://... fournie par Railway
DATABASE_POOL_TAILLE=         # Nombre de connexions du pool, une seule instance d'API

# --- Jetons et securite --------------------------------------------------
JWT_SECRET=                   # Secret de signature des jetons d'acces
JWT_DUREE_MINUTES=            # Duree de vie d'un jeton d'acces
JWT_RAFRAICHISSEMENT_JOURS=   # Duree de vie d'un jeton de rafraichissement
CORS_ORIGINES=                # Liste exacte d'origines autorisees, separees par des virgules
PREUVE_PIN_SECONDES=          # Duree de validite de la preuve de code PIN, 120 par defaut

# --- Compte administrateur initial ---------------------------------------
ADMIN_INITIAL_EMAIL=          # E-mail du premier compte admin cree au demarrage
ADMIN_INITIAL_MOT_DE_PASSE=   # Mot de passe du premier compte admin, a changer apres la premiere connexion

# --- Verification des identifiants ---------------------------------------
VERIFICATION_LIVRAISON_TELEPHONE=  # demo ou reel, valeur initiale du parametre
VERIFICATION_LIVRAISON_EMAIL=      # demo ou reel, valeur initiale du parametre
VERIFICATION_DUREE_MINUTES=        # Duree de validite d'un code de verification
VERIFICATION_ESSAIS_MAX=           # Nombre d'essais avant blocage d'un code

# --- Envoi d'e-mail par l'API Gmail (jamais SMTP, bloque par Railway) -----
GMAIL_CLIENT_ID=              # Identifiant client OAuth du projet Google
GMAIL_CLIENT_SECRET=          # Secret client OAuth
GMAIL_REFRESH_TOKEN=          # Jeton de rafraichissement du compte expediteur
GMAIL_EXPEDITEUR=             # Adresse qui envoie les codes et les recus

# --- Paiement GeniusPay --------------------------------------------------
GENIUSPAY_URL_BASE=           # URL de base de l'API GeniusPay
GENIUSPAY_CLE_TEST=           # Cle marchand du mode test
GENIUSPAY_CLE_REELLE=         # Cle marchand du mode reel
GENIUSPAY_SECRET_WEBHOOK=     # Secret de verification de signature des webhooks
GENIUSPAY_URL_RETOUR=         # URL de retour apres paiement

# --- Notifications Firebase ----------------------------------------------
FIREBASE_PROJET_ID=           # Identifiant du projet Firebase
FIREBASE_COMPTE_SERVICE=      # Contenu JSON du compte de service, encode en base64
FCM_ACTIF=                    # true ou false, coupe les envois push sans toucher au code

# --- Connexion Google et Apple -------------------------------------------
GOOGLE_CLIENT_ID_WEB=         # Identifiant client Google pour le web
GOOGLE_CLIENT_ID_ANDROID=     # Identifiant client Google pour Android
GOOGLE_CLIENT_ID_IOS=         # Identifiant client Google pour iOS
APPLE_CLIENT_ID=              # Identifiant de service Apple
APPLE_TEAM_ID=                # Identifiant d'equipe Apple
APPLE_CLE_ID=                 # Identifiant de la cle de connexion Apple
APPLE_CLE_P8=                 # Contenu de la cle .p8, encode en base64

# --- Stockage des images -------------------------------------------------
STOCKAGE_URL_PUBLIQUE=        # URL publique des avatars et des photos de plats
STOCKAGE_DOSSIER=             # Dossier ou chemin de depot des fichiers envoyes
STOCKAGE_TAILLE_MAX_MO=       # Taille maximale acceptee pour un envoi

# --- Clients -------------------------------------------------------------
APP_API_URL=                  # URL de l'API passee a Flutter par --dart-define
NEXT_PUBLIC_API_URL=          # URL de l'API lue par le site Next.js
