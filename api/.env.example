# Variables lues par l'API. Aucune valeur ici : le dépôt est public.
# Copier en api/.env pour le poste local, poser les mêmes noms dans les variables du service Railway.

# --- Obligatoires : l'API refuse de démarrer sans elles ou avec une valeur d'exemple ---
DATABASE_URL=                 # Fournie par Railway (postgres://...), convertie en postgresql+asyncpg://
SECRET_KEY=                   # 32 caractères au moins, openssl rand -hex 32 (JWT_SECRET accepté aussi)
ADMIN_ACTIONS_PASSWORD=       # 12 caractères au moins, protège les actions sensibles du back office
CORS_ORIGINS=                 # Liste exacte d'origines séparées par des virgules, jamais *

# --- Facultatives, avec un défaut sûr ---
APP_ENV=                      # local, demo ou production
RAILWAY_GIT_COMMIT_SHA=       # Posée par Railway, renvoyée tronquée par GET /health
DOCS_ENABLED=                 # true par défaut ; false coupe /docs et /openapi.json
LOG_NIVEAU=                   # debug, info (défaut), warning ou error
DATABASE_POOL_TAILLE=         # Connexions du pool, 5 par défaut
DB_LOCK_TIMEOUT_MS=           # Attente maximale d'un verrou, 5000 par défaut
DB_STATEMENT_TIMEOUT_MS=      # Durée maximale d'une requête SQL, 15000 par défaut
TAILLE_REQUETE_MAX_KO=        # Taille maximale d'un corps de requête, 1024 par défaut
LIMITE_DEBIT_DEFAUT=          # Limite par adresse IP, 120/minute par défaut
PROXIES_DE_CONFIANCE=         # Relais devant l'API pour lire l'adresse réelle, 1 sur Railway
JWT_DUREE_MINUTES=            # Durée du jeton d'accès, 15 par défaut
BCRYPT_TOURS=                 # Coût bcrypt, 12 par défaut ; ne l'abaisser que pour les tests

# --- Premier compte admin, créé au démarrage s'il n'existe pas, jamais écrasé ensuite ---
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_MOT_DE_PASSE=   # 8 à 64 caractères, une lettre et un chiffre

# --- Tests locaux seulement ---
TEST_DATABASE_URL=            # Base jetable des tests pytest, jamais celle de production

# --- Recette, à taper dans son propre terminal, jamais dans un fichier ---
RECETTE_ADMIN_IDENTIFIANT=
RECETTE_ADMIN_MOT_DE_PASSE=
RECETTE_MOT_DE_PASSE_ACTIONS=
