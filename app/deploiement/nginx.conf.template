# Role du fichier : service statique de l application web. Toute route rend index.html, et le code
# de l application, qui garde le meme nom d une version a l autre, est revalide a chaque chargement.
server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  gzip on;
  gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location = /index.html { add_header Cache-Control "no-cache"; }
  location = /flutter_service_worker.js { add_header Cache-Control "no-store"; }
  location ~* ^/(main\.dart\.js|flutter_bootstrap\.js|flutter\.js|version\.json|manifest\.json)$ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }
  location ^~ /assets/ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }
  location / { try_files $uri $uri/ /index.html; }
}
